---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Lightbox from '../components/Lightbox.astro';
import { getSite } from '../lib/site';
const site = getSite();
interface Props { title: string; description: string; ogImage?: string; jsonLd?: object[] }
const { title, description, ogImage, jsonLd } = Astro.props;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <Seo title={title} description={description} ogImage={ogImage} jsonLd={jsonLd} />
  <slot name="head" />
</head>
<body>
  <div class="frame"><div class="bl"></div><div class="br"></div><span class="sc-l">ЕКБ · Р. Меркелло</span><span class="sc-r">М 1:1 · 2026</span></div>
  <main><slot /></main>
  <Lightbox />
</body>
</html>
