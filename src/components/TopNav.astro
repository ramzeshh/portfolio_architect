---
import { getSite } from '../lib/site';
import { withBase } from '../lib/url';
const site = getSite();
---
<div class="topnav">
  <a href={withBase('/')} class="mark">{site.name}</a>
  <div class="links">
    <a href={withBase('/#work')}>Проекты</a>
    <a href={withBase('/#about')}>Обо мне</a>
    {site.resume_pdf && <a href={withBase('/#contact')}>Резюме</a>}
    <a href={withBase('/#contact')}>Контакты</a>
  </div>
</div>

<script is:inline>
  (function () {
    // view transitions wipe the inline style on <html> and swap in a new nav,
    // so re-query and re-sync on every astro:page-load (the script itself is
    // deduplicated by ClientRouter and runs only once)
    var observer = new ResizeObserver(function (entries) {
      var nav = entries[entries.length - 1].target;
      document.documentElement.style.setProperty('--nav-h', nav.offsetHeight + 'px');
    });
    var attach = function () {
      var nav = document.querySelector('.topnav');
      if (!nav) return;
      document.documentElement.style.setProperty('--nav-h', nav.offsetHeight + 'px');
      observer.disconnect();
      observer.observe(nav);
    };
    attach();
    document.addEventListener('astro:page-load', attach);
  })();
</script>
