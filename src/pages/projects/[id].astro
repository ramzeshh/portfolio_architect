---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;

const title =
  d.seo_title ??
  [d.title, d.type, d.location].filter(Boolean).join(' — ') + ' | Роман Меркелло, архитектор';
const description =
  d.seo_description ??
  `${d.title}${d.location ? ', ' + d.location : ''} — ${d.type.toLowerCase()}` +
    `${d.developer ? ', застройщик «' + d.developer + '»' : ''}` +
    `${d.year ? ', ' + d.year : ''}. Проект в портфолио архитектора Романа Меркелло.`;
const heading = d.h1_suffix ? `${d.title} — ${d.h1_suffix}` : d.title;

const meta: { label: string; value: string }[] = [
  { label: 'Тип', value: d.type },
  ...(d.location ? [{ label: 'Локация', value: d.location }] : []),
  ...(d.developer ? [{ label: 'Застройщик', value: d.developer }] : []),
  ...(d.stage ? [{ label: 'Стадия', value: d.stage }] : []),
  ...(d.year ? [{ label: 'Год', value: String(d.year) }] : []),
];

const place = d.location ? `, ${d.location}` : '';
function altFor(img: { caption?: string }, i: number) {
  return img.caption
    ? `${d.title}${place} — ${img.caption}`
    : `${d.title}${place} — ${d.type.toLowerCase()}, визуализация ${i + 1}`;
}
const images = [...d.renders, ...d.drawings];
const large = await Promise.all(
  images.map((img) => getImage({ src: img.file, width: Math.min(2500, img.file.width), format: 'webp' })),
);
const og = await getImage({ src: d.cover, width: 1200, format: 'jpeg' });
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.title,
    creator: { '@type': 'Person', name: 'Роман Меркелло' },
    ...(d.location ? { locationCreated: d.location } : {}),
    ...(d.year ? { dateCreated: String(d.year) } : {}),
  },
];
---
<Base title={title} description={description} ogImage={og.src} jsonLd={jsonLd}>
  <TopNav />
  <div class="pad" data-lightbox>
    <p class="back back-top"><a href={withBase('/#work')}>← Все проекты</a></p>
    <div class="section-head"><h1>{heading}</h1></div>
    <div class="p-meta">
      {meta.map((m) => (
        <div class="row"><span class="label">{m.label}</span><span class="val">{m.value}</span></div>
      ))}
    </div>
    <Content />
    {images.map((img, i) => (
      <figure>
        <a
          class="lb"
          href={large[i].src}
          data-pswp-width={large[i].attributes.width}
          data-pswp-height={large[i].attributes.height}
          data-caption={img.caption ?? altFor(img, i)}
          target="_blank"
          rel="noopener"
        >
          <Image
            src={img.file}
            widths={[480, 960, 1600]}
            format="webp"
            alt={altFor(img, i)}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </a>
        {img.caption && <figcaption class="img-cap">{img.caption}</figcaption>}
      </figure>
    ))}
    <p class="back"><a href={withBase('/#work')}>← Все проекты</a></p>
  </div>
  <Footer />
</Base>

<style>
  /* case page only: these elements did not exist on the original single page,
     styled to match the original's section-head/img-cap look */
  .section-head h1 { font-family: var(--serif); font-size: 28px; font-weight: 400; }
  .back { font-size: 13px; }
  .back a { color: var(--dim); transition: color .2s; }
  .back a:hover { color: var(--fg); }
  .back-top { margin-top: 96px; }
  figure { margin: 24px 0 0; }
  figure img { width: 100%; height: auto; display: block; }
  figcaption.img-cap { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin-top: 8px; }
  .p-meta { margin-bottom: 24px; }
  .back:not(.back-top) { margin-top: 24px; }
</style>
